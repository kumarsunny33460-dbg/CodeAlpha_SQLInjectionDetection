# ===================================================================
# SQLShield - environment template
# Copy to .env and fill in the values. Never commit the filled file.
# ===================================================================

# --- Application ----------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
PORT=5000

# --- Cloud database (MongoDB Atlas) ---------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=SQLInjectionSecurity
COLLECTION_NAME=SecureUsers
EVENTS_COLLECTION=AttackLogs
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=1
MONGO_RETRY_WRITES=true
MONGO_AUTO_INDEX=true

# --- Encryption -----------------------------------------------------
# Format: <key-id>:<base64 32 byte key>. Multiple keys allow rotation.
# Generate one with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AES_KEYS=v1:REPLACE_WITH_BASE64_KEY
ACTIVE_KEY_ID=v1

# --- Capability verification ----------------------------------------
# Either a plaintext code, a SHA-256 digest, or several codes.
CAPABILITY_CODES=REPLACE_WITH_CAPABILITY_CODE
# CAPABILITY_CODE_SHA256=
CAPABILITY_MAX_ATTEMPTS=5
CAPABILITY_LOCKOUT_SECONDS=300

# --- Password hashing ------------------------------------------------
PBKDF2_ITERATIONS=600000

# --- Detection engine ------------------------------------------------
SQLI_BLOCK_THRESHOLD=40
SQLI_MAX_FIELD_LENGTH=512
SQLI_LOG_PAYLOAD_MAX=500

# --- Rate limiting ----------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_REGISTRATION=10 per minute
RATELIMIT_DASHBOARD=60 per minute

# --- Security headers and CORS ---------------------------------------
TALISMAN_ENABLED=true
TALISMAN_FORCE_HTTPS=true
CORS_ORIGINS=

# --- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
LOG_DIR=
LOG_REQUESTS=true

# --- Operations --------------------------------------------------------
TRUSTED_PROXY_COUNT=1
