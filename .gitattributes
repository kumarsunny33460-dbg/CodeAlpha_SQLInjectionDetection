# Normalise the line endings so that the project behaves the same on
# Windows, macOS and Linux. The container and the PaaS platforms expect LF.

* text=auto eol=lf

# Windows specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF or the shebang breaks
*.sh text eol=lf
Procfile text eol=lf
Dockerfile text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
